_ _ How many customers are in the database?
SELECT COUNT(*)
FROM customers;

_ _ How many furniture products are in the database?
SELECT COUNT(*)
FROM furniture;

_ _ How many orders are in the database? 
SELECT COUNT(*)
FROM orders;

_ _ Display all customer information.
SELECT* FROM customers;
_ _ Display all furniture informatoon.
SELECT* FROM furniture;

_ _ Display all order information.
SELECT* FROM orders;

_ _ Display customer names and their countries.
SELECT customer_name, country
FROM customers;

_ _ Display furniture names and their prices.
SELECT name, price
FROM furniture;

_ _ Display furniture names, categories and colors.
SELECT name, category, color
FROM furniture;

_ _ Display order IDs and quantities.
SELECT order_id, quantity
FROM orders;
